# Windmill AC — Blynk device tokens. copy to .env and fill in.
WINDMILL_HOST=dashboard.windmillair.com
WINDMILL_RATE_PER_KWH=0.105
# Datastream carrying instantaneous watts
WINDMILL_POWER_PIN=v15

WINDMILL_TOKEN_BEDROOM=your-32-char-blynk-device-token
WINDMILL_TOKEN_KITCHEN=your-32-char-blynk-device-token
WINDMILL_TOKEN_LIVING_ROOM=your-32-char-blynk-device-token
WINDMILL_TOKEN_LIZS_OFFICE=your-32-char-blynk-device-token
WINDMILL_TOKEN_ROBS_OFFICE=your-32-char-blynk-device-token
WINDMILL_TOKEN_THIRD_FLOOR_LEFT=your-32-char-blynk-device-token
WINDMILL_TOKEN_THIRD_FLOOR_RIGHT=your-32-char-blynk-device-token
