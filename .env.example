# Windmill AC — Blynk device tokens. copy to .env and fill in.
WINDMILL_HOST=dashboard.windmillair.com
WINDMILL_RATE_PER_KWH=0.105
# Datastream carrying instantaneous watts
WINDMILL_POWER_PIN=v15

# Optional: compare energy use before/after adding or removing units.
WINDMILL_LAT=40.7128
WINDMILL_LON=-74.0060
# Units that changed rooms, so history is labelled by where they actually were
WINDMILL_MOVED_ON=
WINDMILL_PRIOR_ROOMS=
WINDMILL_CHANGE_DATE=
WINDMILL_NEW_UNITS=

# Units are normally added in the app (Settings -> Add AC unit), which keeps the
# tokens in the database rather than in a file. These lines are only a way to
# seed a fresh install: anything here is imported once on first run and then
# ignored. The room name becomes the unit's name.
#WINDMILL_TOKEN_BEDROOM=your-32-char-blynk-device-token
#WINDMILL_TOKEN_LIVING_ROOM=your-32-char-blynk-device-token
#WINDMILL_TOKEN_SPARE_ROOM=your-32-char-blynk-device-token

# Restart serve.py when a .py file changes. Set to 0 to leave a long-running
# instance alone.
WINDMILL_RELOAD=1

# The state a unit is returned to when nothing is on file for it yet.
# Names or raw codes both work. Setpoint is deliberately not included --
# it is a per-room preference, so whatever the unit has is kept.
WINDMILL_DEFAULT_POWER=on
WINDMILL_DEFAULT_MODE=cool
WINDMILL_DEFAULT_FAN=auto

# Alerts for the things this tool cannot fix itself: a unit that has dropped its
# cloud session, a filter that needs changing, and a unit still overrunning after
# the watchdog gives up. All optional; with none set, problems are shown on the
# page but not delivered.
#WINDMILL_ALERT_WEBHOOK=https://ntfy.sh/your-topic
#WINDMILL_ALERT_EMAIL=you@example.com
#WINDMILL_ALERT_DESKTOP=1
#WINDMILL_SMTP_HOST=smtp.example.com
#WINDMILL_SMTP_PORT=587
#WINDMILL_SMTP_USER=
#WINDMILL_SMTP_PASS=
#WINDMILL_SMTP_FROM=

# Snapshots of windmill.db. Windmill keeps 30 days; anything older exists only
# here, so this is the only protection for history that cannot be re-fetched.
#WINDMILL_BACKUP_DIR=
#WINDMILL_BACKUP_KEEP=14
#WINDMILL_BACKUP_INTERVAL_H=20
#WINDMILL_BACKUP_ENABLED=1

# Software thermostat guard: switch a unit off when its own thermostat keeps
# cooling a room already below setpoint. Off by default -- it drives hardware,
# and only some units need it. Enable per unit in the dashboard.
#WINDMILL_GUARD=1

# Action log. Written by the app itself, so it happens however you start it.
#WINDMILL_LOG_DIR=
#WINDMILL_LOG_KEEP=14
#WINDMILL_LOG=1
